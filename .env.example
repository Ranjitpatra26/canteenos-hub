# CanteenOS environment variables
#
# On Lovable Cloud these are injected automatically — you do not need this file.
# Copy to `.env` only when running or deploying the app outside Lovable.

# ---- Client (exposed to the browser, publishable values only) ----
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ---- Server (never exposed to the browser) ----
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
# Service-role key bypasses row level security. Store it as an encrypted
# environment variable in your host's dashboard, never in a committed file.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: build target for self-hosting. cloudflare (default) | vercel | netlify | node-server
# NITRO_PRESET="vercel"

# ---- Monitoring (optional, all client-side) ----
# Leave blank to keep the built-in console provider only. When set, register the
# matching SDK inside initMonitoring() in src/lib/monitoring.ts.
VITE_SENTRY_DSN=""
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
# Shown on the monitoring integrations panel and attached to captured events.
VITE_APP_RELEASE="1.0.0"
